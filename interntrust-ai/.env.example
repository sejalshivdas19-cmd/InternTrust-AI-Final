# ---------------------------------------------------------------------------
# InternTrust AI - Environment Configuration Example
# Copy this file to ".env" and fill in real values. NEVER commit the real .env
# ---------------------------------------------------------------------------

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-string

# Database (SQLite by default; swap for MySQL/PostgreSQL URL in production)
DATABASE_URL=sqlite:///instance/interntrust.db

# File uploads
UPLOAD_FOLDER=instance/uploads
REPORT_FOLDER=instance/reports
MAX_CONTENT_LENGTH_MB=5

# Optional AI integration (Anthropic Claude).
# If left empty, the app automatically falls back to rule-based-only analysis
# and clearly labels results as such. No feature breaks without this key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Session / cookie security (set to true in production behind HTTPS)
SESSION_COOKIE_SECURE=false

# Rate limiting storage (memory is fine for dev/demo; use redis:// in prod)
RATELIMIT_STORAGE_URI=memory://
